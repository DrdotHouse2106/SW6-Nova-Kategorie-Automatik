<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="Nova\KategorieAutomatik\Service\CategoryAssigner">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="product_category.repository"/>
            <argument type="service" id="property_group.repository"/>
            <argument type="service" id="Shopware\Core\Content\Product\DataAbstractionLayer\ProductIndexer"/>
            <call method="setLogger">
                <argument type="service" id="logger"/>
            </call>
            <!-- Langlebige Worker: Code-Zwischenspeicher nach jeder Nachricht verwerfen -->
            <tag name="kernel.reset" method="resetCache"/>
        </service>

        <service id="Nova\KategorieAutomatik\Subscriber\ProductWrittenSubscriber">
            <argument type="service" id="Nova\KategorieAutomatik\Service\CategoryAssigner"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="messenger.default_bus"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Nova\KategorieAutomatik\Message\RebuildHandler">
            <argument type="service" id="Nova\KategorieAutomatik\Service\CategoryAssigner"/>
            <argument type="service" id="messenger.default_bus"/>
            <tag name="messenger.message_handler"/>
        </service>
    </services>
</container>
